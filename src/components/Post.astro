---
import { formatDate, type DateOptions } from "@/lib/util";

const { post } = Astro.props;

const dateOptions: DateOptions = {
  month: 'short',

}
---

<li
  class="font-bold hover:text-accent hover:dark:text-dark-accent"
>
  <a
    href={`/blog/${post.id}`}
    class="flex w-full flex-row justify-between gap-2"
  >
      <span class="">
        {post.data.title}
      </span>
      <span>
        {formatDate(post.data.publicationDate, dateOptions)}
    </span>
  </a>
</li>
